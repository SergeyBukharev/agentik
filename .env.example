# Server-only. Never prefix secrets with VITE_.
AGENTIK_CODES_FILE=codes-for-pro.txt
AGENTIK_ACCESS_SECRET=
AGENTIK_ACCOUNT_EMAIL=
AGENTIK_ACCOUNT_EMAIL_ALIASES=
AGENTIK_ACCOUNT_CODE=
# JSON array of separate email-code accounts. Store real entries in the server environment.
AGENTIK_CLIENT_ACCOUNTS=[]
AGENTIK_PRO_CODES=
VITE_PRO_CHECKOUT_URL=
AI_API_KEY=
AI_MODEL=
AI_VISION=false
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=
AI_DEEPSEEK_API_KEY=
AI_DEEPSEEK_MODEL=
AI_ALICE_API_KEY=
AI_ALICE_FOLDER_ID=
AI_ALICE_MODEL=aliceai-llm
AI_API_BASE=https://api.openai.com/v1
ALLOWED_ORIGIN=http://127.0.0.1:5173
HOST=127.0.0.1
PORT=3001

# Browser-public. Set VITE_API_URL to the HTTPS API origin for GitHub Pages.
VITE_API_URL=
# Public demo profiles for the static GitHub Pages build.
VITE_DEMO_ACCESS=false
# Optional HTTPS preview entry point for a static build with no separate API.
VITE_ACCESS_PREVIEW_URL=
# Optional public announcements displayed on the signed-in home screen.
VITE_SERVICE_ANNOUNCEMENTS=[]
# Build with the official Web App SDK and separate chat widget entry.
VITE_TELEGRAM_MINI_APP=false
TELEGRAM_BOT_USERNAME=
TELEGRAM_MINI_APP_SHORT_NAME=
TELEGRAM_SHARE_DIR=./data/telegram-shares
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
